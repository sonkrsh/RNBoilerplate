{
  "name": "RNBoilerplate",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "//": "=== Basic Commands ===",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "//dev": "=== Development Environment (.env.development) ===",
    "start:dev": "ENVFILE=.env.development react-native start",
    "android:dev": "ENVFILE=.env.development react-native run-android",
    "ios:dev": "ENVFILE=.env.development react-native run-ios",
    "build:android:dev": "ENVFILE=.env.development cd android && ./gradlew assembleDebug",
    "build:ios:dev": "ENVFILE=.env.development npx react-native build-ios --mode=Debug",
    "//QA": "=== QA Environment (.env.qa) ===",
    "start:qa": "ENVFILE=.env.qa react-native start",
    "android:qa": "ENVFILE=.env.qa react-native run-android",
    "ios:qa": "ENVFILE=.env.qa react-native run-ios",
    "build:android:qa": "ENVFILE=.env.qa cd android && ./gradlew assembleRelease",
    "build:ios:qa": "ENVFILE=.env.qa npx react-native build-ios --mode=Release",
    "//prod": "=== Production Environment (.env.production) ===",
    "start:prod": "ENVFILE=.env.production react-native start",
    "android:prod": "ENVFILE=.env.production react-native run-android",
    "ios:prod": "ENVFILE=.env.production react-native run-ios",
    "build:android:prod": "ENVFILE=.env.production cd android && ./gradlew assembleRelease",
    "build:ios:prod": "ENVFILE=.env.production npx react-native build-ios --mode=Release",
    "//generators": "=== Code Generators (Plop) ===",
    "plop": "plop",
    "generate": "plop",
    "g:screen": "plop screen",
    "g:component": "plop component",
    "g:hook": "plop hook",
    "g:slice": "plop slice",
    "g:api": "plop api"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native/new-app-screen": "0.80.2",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/drawer": "^7.5.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.11.0",
    "i18next": "^25.3.6",
    "react": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.6.1",
    "react-native": "0.80.2",
    "react-native-config": "^1.5.6",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-localize": "^3.5.2",
    "react-native-reanimated": "^3.19.1",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-screens": "^4.14.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "19.1.1",
    "@react-native-community/cli-platform-android": "19.1.1",
    "@react-native-community/cli-platform-ios": "19.1.1",
    "@react-native/babel-preset": "0.80.2",
    "@react-native/eslint-config": "0.80.2",
    "@react-native/metro-config": "0.80.2",
    "@react-native/typescript-config": "0.80.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "plop": "^4.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
