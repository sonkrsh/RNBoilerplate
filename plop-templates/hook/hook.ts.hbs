    console.log('use{{pascalCase name}} mounted');
    
    return () => {
      // TODO: Add cleanup logic here
      console.log('use{{pascalCase name}} cleanup');
    };
  }, []);
{{/if}}

  // TODO: Add your hook logic here
  const handle{{pascalCase name}}Action = () => {
{{#if withState}}
    setLoading(true);
    setError(null);
    
    try {
      // TODO: Add your action logic here
