const initialState: {{pascalCase name}}State = {
  items: [],
  selectedItem: null,
  isLoading: false,
  error: null,
};

const {{camelCase name}}Slice = createSlice({
  name: '{{camelCase name}}',
  initialState,
  reducers: {
    // Loading states
    set{{pascalCase name}}Loading: (state, action: PayloadAction<boolean>) => {
      state.isLoading = action.payload;
      if (action.payload) {
        state.error = null;
      }
    },

    // Success actions
    set{{pascalCase name}}Items: (state, action: PayloadAction<{{pascalCase name}}Item[]>) => {
      state.items = action.payload;
      state.isLoading = false;
      state.error = null;
    },

    add{{pascalCase name}}Item: (state, action: PayloadAction<{{pascalCase name}}Item>) => {
      state.items.push(action.payload);
    },

    update{{pascalCase name}}Item: (state, action: PayloadAction<{{pascalCase name}}Item>) => {
      const index = state.items.findIndex(item => item.id === action.payload.id);
      if (index !== -1) {
        state.items[index] = action.payload;
      }
    },

    remove{{pascalCase name}}Item: (state, action: PayloadAction<string>) => {
      state.items = state.items.filter(item => item.id !== action.payload);
      if (state.selectedItem?.id === action.payload) {
        state.selectedItem = null;
      }
    },

    // Selection
    select{{pascalCase name}}Item: (state, action: PayloadAction<{{pascalCase name}}Item | null>) => {
      state.selectedItem = action.payload;
    },

    // Error handling
    set{{pascalCase name}}Error: (state, action: PayloadAction<string>) => {
      state.error = action.payload;
      state.isLoading = false;
    },

    clear{{pascalCase name}}Error: (state) => {
      state.error = null;
    },

    // Reset state
    reset{{pascalCase name}}State: () => initialState,
  },
});

export const {
